{
  "name": "CardCat",
  "version": "1.0.0",
  "description": "Trading Card Management System",
  "main": "index.js",
  "scripts": {
    "start": "concurrently -n \"client,server\" \"npm run client\" \"npm run server\"",
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "clean": "rm -rf node_modules client/node_modules server/node_modules"
  },
  "keywords": ["trading-cards", "inventory", "management"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}